---
/**
 * Base.astro — the document shell: SEO + OpenGraph metadata, critical font
 * preloads, the shared SVG defs, the skip link, and the fixed cinematic stage.
 * Reduced-motion is reflected as a class so CSS and JS can branch consistently.
 */
import '@styles/global.css';
import SvgDefs from '@art/SvgDefs.astro';
import { content } from '@config/content';

interface Props {
  title?: string;
  description?: string;
}
const { title = content.meta.title, description = content.meta.description } = Astro.props;

// Base-aware asset URLs so the site works at any deploy path (e.g. GitHub Pages
// project page at /gallery/). BASE_URL always ends with a slash.
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base}${p.replace(/^\//, '')}`;
const ogImage = new URL(asset(content.meta.ogImage), Astro.site ?? 'https://example.com').toString();

// @font-face is declared here (not in a .css file) so the woff2 URLs can carry
// the base path. Self-hosted + preloaded → no layout shift.
const fonts = [
  { family: 'Cormorant Garamond', file: 'fonts/cormorant-garamond.woff2', weight: '400 600' },
  { family: 'EB Garamond', file: 'fonts/eb-garamond.woff2', weight: '400 500' },
  { family: 'Pinyon Script', file: 'fonts/pinyon-script.woff2', weight: '400' },
];
const fontFaceCss = fonts
  .map(
    (f) =>
      `@font-face{font-family:'${f.family}';font-style:normal;font-weight:${f.weight};font-display:swap;src:url('${asset(f.file)}') format('woff2')}`,
  )
  .join('');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=5" />
    <meta name="theme-color" content="#162239" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph / WhatsApp share -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Critical fonts (self-hosted, base-aware @font-face + preload, no layout shift) -->
    <style set:html={fontFaceCss}></style>
    {fonts.map((f) => (
      <link rel="preload" href={asset(f.file)} as="font" type="font/woff2" crossorigin />
    ))}

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <script is:inline>
      // Reflect reduced-motion as a root class as early as possible (no FOUC of motion).
      try {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('reduced-motion');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to invitation</a>
    <SvgDefs />
    <main id="main" class="stage">
      <slot />
    </main>
  </body>
</html>

<style>
  .stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--clr-midnight-deep);
  }

  /* Tablet & desktop: the invitation is framed like a handcrafted card on a
     textured emerald backdrop (SCREEN_BOOK "Desktop: invitation framed on a
     textured background"). `contain` on .stage scopes the scenes' fixed
     full-bleed layers and the chrome to the frame rather than the viewport. */
  @media (min-width: 760px) {
    body {
      display: grid;
      place-items: center;
      background:
        radial-gradient(120% 120% at 50% 0%, #2f5a4e 0%, #23463d 38%, #16322b 78%, #102620 100%);
    }
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.06;
      mix-blend-mode: overlay;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.012 0.5' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    }
    .stage {
      position: relative;
      inset: auto;
      width: min(var(--stage-max), 94vw);
      height: min(900px, 92vh);
      border-radius: 28px;
      box-shadow:
        0 40px 90px rgba(8, 16, 12, 0.55),
        0 0 0 1px rgba(200, 168, 107, 0.25),
        0 0 0 10px rgba(246, 241, 231, 0.03);
      contain: layout paint;
    }
  }

  @media (min-width: 760px) and (max-width: 1100px) {
    .stage {
      width: min(460px, 70vw);
    }
  }
</style>
