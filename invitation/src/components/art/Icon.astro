---
/**
 * Icon.astro — the illustrated icon library (ASSET_BOOK §10). One stroke
 * language, gold by default, sized 24/32/48. Decorative by default; pass a
 * `title` to expose an accessible label.
 */
type IconName =
  | 'calendar'
  | 'clock'
  | 'venue'
  | 'dress'
  | 'directions'
  | 'whatsapp'
  | 'share'
  | 'restart'
  | 'sound'
  | 'sound-off'
  | 'lantern'
  | 'ring'
  | 'chevron';

interface Props {
  name: IconName;
  size?: number;
  title?: string;
  class?: string;
  color?: string;
}
const { name, size = 28, title, class: className = '', color = 'url(#foil)' } = Astro.props;
const common = {
  fill: 'none',
  stroke: color,
  'stroke-width': 1.6,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

<svg
  class={`icon icon--${name} ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}

  {name === 'calendar' && (
    <g {...common}>
      <rect x="3.5" y="5" width="17" height="15" rx="2.5" />
      <path d="M3.5 9h17M8 3v3M16 3v3" />
      <circle cx="8.5" cy="13" r="0.6" fill={color} stroke="none" />
      <circle cx="12" cy="13" r="0.6" fill={color} stroke="none" />
      <circle cx="15.5" cy="13" r="0.6" fill={color} stroke="none" />
    </g>
  )}
  {name === 'clock' && (
    <g {...common}>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7v5l3.2 2" />
    </g>
  )}
  {name === 'venue' && (
    <g {...common}>
      <path d="M12 21c4.5-4.2 7-7.4 7-10.6A7 7 0 0 0 5 10.4C5 13.6 7.5 16.8 12 21z" />
      <circle cx="12" cy="10.2" r="2.6" />
    </g>
  )}
  {name === 'dress' && (
    <g {...common}>
      <path d="M9 3l3 3 3-3M9 3c0 3-2 4-2 6l-2 4h14l-2-4c0-2-2-3-2-6M7.5 13l-1.5 7h12l-1.5-7" />
    </g>
  )}
  {name === 'directions' && (
    <g {...common}>
      <path d="M12 2.5l9.5 9.5L12 21.5 2.5 12 12 2.5z" />
      <path d="M9.5 13.5v-2.2a2 2 0 0 1 2-2h3.2M13 7.5l2 1.8-2 1.8" />
    </g>
  )}
  {name === 'whatsapp' && (
    <g {...common}>
      <path d="M4 20l1.3-3.9A7.4 7.4 0 1 1 8.4 19L4 20z" />
      <path d="M9 9.2c.2-.6.5-.6.8-.6h.5c.2 0 .4 0 .6.5l.6 1.4c.1.2 0 .4-.1.5l-.5.6c-.1.1-.2.3-.1.5a4.4 4.4 0 0 0 2.3 2c.2.1.4 0 .5-.1l.5-.6c.2-.2.3-.2.5-.1l1.3.7c.2.1.3.3.3.5a1.7 1.7 0 0 1-1.2 1.5c-.5.1-1 .2-3-.8a7 7 0 0 1-2.8-3c-.6-1.2-.5-1.9-.5-2.5z" />
    </g>
  )}
  {name === 'share' && (
    <g {...common}>
      <circle cx="6" cy="12" r="2.4" />
      <circle cx="17.5" cy="6" r="2.4" />
      <circle cx="17.5" cy="18" r="2.4" />
      <path d="M8.1 11l7.3-3.8M8.1 13l7.3 3.8" />
    </g>
  )}
  {name === 'restart' && (
    <g {...common}>
      <path d="M19 12a7 7 0 1 1-2.1-5" />
      <path d="M17 4v3.2h-3.2" />
    </g>
  )}
  {name === 'sound' && (
    <g {...common}>
      <path d="M4 9.5h3l4-3.5v12l-4-3.5H4z" />
      <path d="M15 9a3.5 3.5 0 0 1 0 6M17.5 7a6.5 6.5 0 0 1 0 10" />
    </g>
  )}
  {name === 'sound-off' && (
    <g {...common}>
      <path d="M4 9.5h3l4-3.5v12l-4-3.5H4z" />
      <path d="M16 9.5l4 5M20 9.5l-4 5" />
    </g>
  )}
  {name === 'lantern' && (
    <g {...common}>
      <path d="M12 2.5v2M9 6h6l1 2v8l-1 2H9l-1-2V8z" />
      <path d="M9.5 6.5c0 4 5 4 5 0M12 9v6" />
    </g>
  )}
  {name === 'ring' && (
    <g {...common}>
      <circle cx="12" cy="14" r="5.5" />
      <path d="M9.5 8.5L11 4h2l1.5 4.5" />
      <path d="M12 4l-1.2 1.6L12 7l1.2-1.4L12 4z" fill={color} stroke="none" />
    </g>
  )}
  {name === 'chevron' && (
    <g {...common}>
      <path d="M9 6l6 6-6 6" />
    </g>
  )}
</svg>

<style>
  .icon { display: block; }
</style>
