---
/**
 * WaxSeal.astro — H003 Wax Seal in deep burgundy with an embossed PP cipher.
 * Layered for Scene 2's crack: the seal body sits under fragment shards
 * (#wax-frag-*) the scene flings outward and fades, revealing the paper beneath.
 */
import Monogram from './Monogram.astro';

interface Props {
  size?: number;
  class?: string;
}
const { size = 96, class: className = '' } = Astro.props;
---

<div class={`wax-seal ${className}`} style={`--w:${size}px`}>
  <svg viewBox="0 0 120 120" width="100%" height="100%" role="img" aria-label="A wax seal pressed with the couple's monogram">
    <!-- soft cast shadow -->
    <ellipse cx="60" cy="98" rx="44" ry="9" fill="#4c372e" opacity="0.3" />

    <g id="wax-whole">
      <!-- irregular wax disc -->
      <path
        id="wax-body"
        d="M60 12c12-2 22 4 30 10s14 16 14 28-4 22-12 30-20 14-32 12-24-4-32-14-12-22-10-34 6-22 16-30 14-10 26-12z"
        fill="url(#wax)"
        filter="url(#soft-shadow-sm)"
      />
      <!-- molten rim highlight -->
      <path
        d="M60 16c10-1 20 4 27 9"
        fill="none"
        stroke="#c25260"
        stroke-width="2"
        stroke-linecap="round"
        opacity="0.5"
      />
      <!-- embossed pressed ring -->
      <circle cx="60" cy="60" r="34" fill="none" stroke="#5b1822" stroke-width="2" opacity="0.6" />
      <circle cx="60" cy="60" r="30" fill="none" stroke="#a23a3a" stroke-width="1" opacity="0.4" />
      <!-- embossed monogram (tonal, not foil) -->
      <g transform="translate(26 26) scale(0.68)" opacity="0.92">
        <Monogram size={100} tone="ink" />
      </g>
    </g>

    <!-- fragment shards (start hidden over the whole seal; revealed on crack) -->
    <g id="wax-shards" opacity="0" style="pointer-events:none">
      <path id="wax-frag-1" d="M60 12c-12 2-18 6-26 12l28 36z" fill="url(#wax)" />
      <path id="wax-frag-2" d="M90 22c8 6 14 16 14 28l-44 10z" fill="url(#wax)" />
      <path id="wax-frag-3" d="M104 64c0 12-4 22-12 30l-32-34z" fill="url(#wax)" />
      <path id="wax-frag-4" d="M76 102c-12 4-24 2-32-6l16-36z" fill="url(#wax)" />
      <path id="wax-frag-5" d="M28 84c-6-10-8-22-4-32l36 8z" fill="url(#wax)" />
    </g>
  </svg>
</div>

<style>
  .wax-seal {
    width: var(--w);
    aspect-ratio: 1;
  }
  .wax-seal svg {
    overflow: visible;
  }
</style>
