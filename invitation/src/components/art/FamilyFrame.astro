---
/**
 * FamilyFrame.astro — P020 framed family emblem (Scene 6). Rather than invent
 * faces (one parent is remembered with reverence), the gold oval frame holds a
 * handcrafted Awadhi crest: a lit diya cradled by mogra sprays — warmth and
 * blessing. The parents' names sit on the plate below.
 */
interface Props {
  names: string; // may contain a newline
  width?: number;
  class?: string;
}
const { names, width = 150, class: className = '' } = Astro.props;
const lines = names.split('\n');
---

<div class={`fam-frame ${className}`} style={`--w:${width}px`}>
  <svg viewBox="0 0 160 200" width="100%" height="100%" role="img" aria-label={`Family of ${lines.join(' ')}`}>
    <!-- frame shadow -->
    <ellipse cx="80" cy="186" rx="56" ry="8" fill="#000" opacity="0.18" />

    <!-- ornate oval frame -->
    <ellipse cx="80" cy="86" rx="64" ry="78" fill="#fbf8f3" />
    <ellipse cx="80" cy="86" rx="64" ry="78" fill="none" stroke="url(#foil)" stroke-width="4" />
    <ellipse cx="80" cy="86" rx="58" ry="72" fill="none" stroke="url(#foil)" stroke-width="1" opacity="0.6" />
    <!-- frame crest top -->
    <path d="M70 10c4-6 16-6 20 0-6-2-14-2-20 0z" fill="url(#foil)" />
    <circle cx="80" cy="8" r="3" fill="url(#foil)" />

    <!-- interior crest: diya + mogra -->
    <g transform="translate(80 86)">
      <!-- mogra sprays -->
      <g opacity="0.95">
        <path d="M-40 6c14-10 26-10 36 2" fill="none" stroke="#5a7c55" stroke-width="1.4" />
        <path d="M40 6c-14-10-26-10-36 2" fill="none" stroke="#5a7c55" stroke-width="1.4" />
        {[-34, -26, 28, 36].map((x, i) => (
          <g transform={`translate(${x} ${i % 2 ? 2 : -2}) scale(0.5)`}>
            {Array.from({ length: 6 }).map((_, k) => (
              <ellipse cx="0" cy="-9" rx="5" ry="9" fill="#fbf8f3" stroke="#e6dccb" stroke-width="0.6" transform={`rotate(${k * 60})`} />
            ))}
            <circle r="3" fill="#e6cf9b" />
          </g>
        ))}
      </g>
      <!-- diya -->
      <path d="M-22 22c0 8 10 12 22 12s22-4 22-12z" fill="url(#foil)" />
      <ellipse cx="0" cy="22" rx="22" ry="5" fill="#b88a42" />
      <path d="M0 22c-1-10 0-16 0-16s1 6 0 16z" fill="#7e2530" opacity="0.3" />
      <!-- flame -->
      <path d="M0 6c3-3 4-7 4-10 0-3-2-6-4-8-2 2-4 5-4 8 0 3 1 7 4 10z" fill="url(#flame)" />
      <path d="M0 3c1.6-2 2.4-4 2.4-6 0-1.6-1-3-2.4-4-1.4 1-2.4 2.4-2.4 4 0 2 .8 4 2.4 6z" fill="#fff4cf" />
    </g>

    <!-- name plate -->
    <g>
      <rect x="22" y="168" width="116" height="26" rx="5" fill="#23463d" />
      <rect x="22" y="168" width="116" height="26" rx="5" fill="none" stroke="url(#foil)" stroke-width="1" />
      {lines.map((line, i) => (
        <text
          x="80"
          y={lines.length > 1 ? 178 + i * 11 : 184}
          text-anchor="middle"
          fill="#f1e7d6"
          font-family="'Cormorant Garamond', Georgia, serif"
          font-size="10"
          font-weight="600"
        >{line}</text>
      ))}
    </g>
  </svg>
</div>

<style>
  .fam-frame { width: var(--w); max-width: 100%; aspect-ratio: 160 / 200; }
  .fam-frame svg { overflow: visible; }
</style>
