---
/**
 * Floral.astro — the floral library (ASSET_BOOK §8). Hand-built blooms sharing
 * one brush language and palette: mogra (white jasmine), rose (dusty), lotus.
 * Variants: single bloom · cluster · corner spray. Used as subtle accents only
 * (CREATIVE_DIRECTOR_NOTES "do not add flowers to fix emptiness").
 */
type Flower = 'mogra' | 'rose' | 'lotus';
type Variant = 'bloom' | 'cluster' | 'corner';

interface Props {
  flower?: Flower;
  variant?: Variant;
  size?: number;
  class?: string;
}
const { flower = 'mogra', variant = 'bloom', size = 64, class: className = '' } = Astro.props;

const petalFill: Record<Flower, string> = {
  mogra: '#fbf8f3',
  rose: '#caa2a5',
  lotus: '#e5c8b4',
};
const petalEdge: Record<Flower, string> = {
  mogra: '#e6dccb',
  rose: '#b98a8d',
  lotus: '#d3a98c',
};
const heart: Record<Flower, string> = {
  mogra: '#e6cf9b',
  rose: '#8c5d61',
  lotus: '#c8a86b',
};
const fill = petalFill[flower];
const edge = petalEdge[flower];
const core = heart[flower];
const leaf = '#5a7c55';
const leafDeep = '#3f5d3c';
---

<svg
  class={`floral ${className}`}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="presentation"
  aria-hidden="true"
>
  {variant === 'corner' && (
    <g>
      <!-- vine -->
      <path d="M6 6c22 4 40 18 50 40" fill="none" stroke={leafDeep} stroke-width="1.4" opacity="0.8" />
      <path d="M14 10c6 2 9 6 9 12-6-1-9-5-9-12z" fill={leaf} />
      <path d="M30 22c6 2 9 6 9 12-6-1-9-5-9-12z" fill={leaf} opacity="0.9" />
    </g>
  )}

  <!-- one bloom (reused for bloom + as a unit inside cluster) -->
  {variant !== 'cluster' && (
    <g transform={variant === 'corner' ? 'translate(40 40) scale(0.7)' : 'translate(20 20) scale(0.9)'}>
      {Array.from({ length: 6 }).map((_, i) => (
        <ellipse
          cx="32"
          cy="14"
          rx="11"
          ry="18"
          fill={fill}
          stroke={edge}
          stroke-width="0.8"
          opacity="0.96"
          transform={`rotate(${i * 60} 32 32)`}
        />
      ))}
      <circle cx="32" cy="32" r="8" fill={core} />
      <circle cx="32" cy="32" r="8" fill="none" stroke={edge} stroke-width="0.6" opacity="0.5" />
    </g>
  )}

  {variant === 'cluster' && (
    <g>
      {[
        { x: 30, y: 34, s: 0.62 },
        { x: 60, y: 28, s: 0.5 },
        { x: 48, y: 58, s: 0.7 },
        { x: 74, y: 56, s: 0.46 },
      ].map((b) => (
        <g transform={`translate(${b.x} ${b.y}) scale(${b.s})`}>
          {Array.from({ length: 6 }).map((_, i) => (
            <ellipse cx="0" cy="-16" rx="10" ry="17" fill={fill} stroke={edge} stroke-width="0.8" transform={`rotate(${i * 60})`} />
          ))}
          <circle r="7" fill={core} />
        </g>
      ))}
      <path d="M18 70c20-10 44-12 66-6" fill="none" stroke={leafDeep} stroke-width="1.2" opacity="0.7" />
      <path d="M40 66c5 2 8 6 8 12-5-1-8-5-8-12z" fill={leaf} />
    </g>
  )}
</svg>

<style>
  .floral { display: block; }
</style>
