---
/**
 * VelvetBox.astro — H001 Royal Invitation Box (emerald velvet, champagne
 * embroidery, silk interior). Layered so Scene 1 can lift the lid:
 *   #box-lid       — the hinged top (scene translates/tilts it on drag)
 *   #box-interior  — silk lining + rising paper revealed underneath
 *   #box-base      — the velvet body
 * Reference proportions 248×180 within a taller canvas to allow the lift.
 */
import Monogram from './Monogram.astro';

interface Props {
  width?: number;
  class?: string;
}
const { width = 248, class: className = '' } = Astro.props;
---

<div class={`velvet-box ${className}`} style={`--w:${width}px`}>
  <svg viewBox="0 0 280 240" width="100%" height="100%" role="img" aria-label="A velvet invitation box">
    <!-- contact shadow -->
    <ellipse id="box-shadow" cx="140" cy="214" rx="104" ry="16" fill="#0c1322" opacity="0.55" />

    <!-- INTERIOR (revealed as the lid lifts) -->
    <g id="box-interior">
      <rect x="52" y="96" width="176" height="92" rx="8" fill="#7e2530" />
      <rect x="52" y="96" width="176" height="92" rx="8" fill="#9a3a44" opacity="0.5" filter="url(#velvet-nap)" />
      <!-- folded ivory paper peeking out -->
      <g id="box-paper-peek">
        <rect x="84" y="70" width="112" height="118" rx="6" fill="url(#paper)" filter="url(#soft-shadow-sm)" />
        <rect x="84" y="70" width="112" height="118" rx="6" fill="none" stroke="#c8a86b" stroke-width="1" opacity="0.55" />
        <line x1="100" y1="92" x2="180" y2="92" stroke="#c8a86b" stroke-width="0.8" opacity="0.4" />
        <line x1="108" y1="104" x2="172" y2="104" stroke="#caa2a5" stroke-width="0.8" opacity="0.4" />
      </g>
    </g>

    <!-- BASE (velvet body) -->
    <g id="box-base">
      <rect x="40" y="150" width="200" height="58" rx="12" fill="url(#velvet)" />
      <rect x="40" y="150" width="200" height="58" rx="12" fill="#000" opacity="0.12" filter="url(#velvet-nap)" />
      <!-- gold embroidery frame -->
      <rect x="49" y="158" width="182" height="42" rx="7" fill="none" stroke="url(#foil)" stroke-width="1.4" opacity="0.9" />
      <!-- corner flourishes -->
      <path d="M58 166c6 0 9 3 9 9" fill="none" stroke="url(#foil)" stroke-width="1.2" opacity="0.8" />
      <path d="M222 166c-6 0-9 3-9 9" fill="none" stroke="url(#foil)" stroke-width="1.2" opacity="0.8" />
    </g>

    <!-- LID (hinged top) -->
    <g id="box-lid" style="transform-box: fill-box; transform-origin: 50% 100%;">
      <rect x="40" y="92" width="200" height="64" rx="12" fill="url(#velvet-lid)" filter="url(#soft-shadow)" />
      <rect x="40" y="92" width="200" height="64" rx="12" fill="#000" opacity="0.1" filter="url(#velvet-nap)" />
      <!-- embroidery -->
      <rect x="49" y="100" width="182" height="48" rx="8" fill="none" stroke="url(#foil)" stroke-width="1.4" opacity="0.9" />
      <path d="M64 110c8 0 12 4 12 12" fill="none" stroke="url(#foil)" stroke-width="1.1" opacity="0.7" />
      <path d="M216 110c-8 0-12 4-12 12" fill="none" stroke="url(#foil)" stroke-width="1.1" opacity="0.7" />
      <path d="M64 138c8 0 12-4 12-12" fill="none" stroke="url(#foil)" stroke-width="1.1" opacity="0.7" />
      <path d="M216 138c-8 0-12-4-12-12" fill="none" stroke="url(#foil)" stroke-width="1.1" opacity="0.7" />
      <!-- monogram medallion -->
      <g transform="translate(116 100) scale(0.48)">
        <Monogram size={100} tone="foil" />
      </g>
    </g>
  </svg>
</div>

<style>
  .velvet-box {
    width: var(--w);
    max-width: 100%;
    aspect-ratio: 280 / 240;
    margin-inline: auto;
  }
  .velvet-box svg {
    overflow: visible;
  }
</style>
