---
/**
 * GoldDivider.astro — H008 / P060 gold divider inspired by Mughal geometry.
 * A restrained horizontal rule with a central lotus medallion and tapering
 * filigree ends. Used between sections and beneath names.
 */
interface Props {
  width?: number;
  class?: string;
  label?: string;
}
const { width = 220, class: className = '', label } = Astro.props;
---

<svg
  class={`gold-divider ${className}`}
  width={width}
  height={Math.round(width * (24 / 220))}
  viewBox="0 0 220 24"
  role={label ? 'img' : 'presentation'}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <!-- tapering lines -->
  <line x1="6" y1="12" x2="86" y2="12" stroke="url(#foil)" stroke-width="1.2" />
  <line x1="134" y1="12" x2="214" y2="12" stroke="url(#foil)" stroke-width="1.2" />
  <!-- end dots -->
  <circle cx="6" cy="12" r="1.6" fill="url(#foil)" />
  <circle cx="214" cy="12" r="1.6" fill="url(#foil)" />
  <!-- small leaf flourishes flanking the medallion -->
  <path d="M86 12c8 0 12-4 16-4-4 4-4 8 0 8-4 0-8-4-16-4z" fill="url(#foil)" opacity="0.85" />
  <path d="M134 12c-8 0-12-4-16-4 4 4 4 8 0 8 4 0 8-4 16-4z" fill="url(#foil)" opacity="0.85" />
  <!-- central lotus medallion -->
  <g transform="translate(110 12)">
    <path d="M0 -8c2 4 2 6 0 9-2-3-2-5 0-9z" fill="url(#foil)" />
    <path d="M0 -8c-2 4-2 6 0 9" fill="none" />
    <path d="M0 9c3-2 6-2 9 0-3 2-6 2-9 0z" fill="url(#foil)" opacity="0.9" transform="rotate(60)" />
    <path d="M0 9c3-2 6-2 9 0-3 2-6 2-9 0z" fill="url(#foil)" opacity="0.9" transform="rotate(-60)" />
    <circle cx="0" cy="0" r="2.4" fill="url(#foil)" />
    <circle cx="0" cy="0" r="5" fill="none" stroke="url(#foil)" stroke-width="0.7" opacity="0.7" />
  </g>
</svg>

<style>
  .gold-divider {
    display: block;
    margin-inline: auto;
  }
</style>
