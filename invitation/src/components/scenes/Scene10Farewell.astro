---
/**
 * Scene 10 — Farewell. A moonlit rooftop with fireflies. The guest releases a
 * floating lantern (2500ms gentle drift); the stars brighten, the thank-you
 * message settles, and the music fades to midnight. (SCREEN_BOOK Scene 10,
 * MOTION_BOOK Scene 10.)
 */
import SceneShell from '@components/ui/SceneShell.astro';
import Lantern from '@art/Lantern.astro';
import GoldText from '@components/ui/GoldText.astro';
import GoldDivider from '@art/GoldDivider.astro';
import Icon from '@art/Icon.astro';
import { content } from '@config/content';
---

<SceneShell id="farewell" labelledby="farewell-heading">
  <div class="farewell">
    <div class="farewell__sky" aria-hidden="true" data-sky>
      {Array.from({ length: 26 }).map((_, i) => {
        const x = (i * 37) % 100;
        const y = (i * 53) % 60;
        const s = (i % 3) + 1;
        return <span class="farewell__star" style={`left:${x}%; top:${y}%; --s:${s}px; --d:${(i % 5) * 0.4}s`}></span>;
      })}
    </div>

    <div class="farewell__message" data-message hidden>
      <h2 class="t-label farewell__kicker" id="farewell-heading">Thank You</h2>
      <p class="t-heading farewell__text">
        {content.farewell.message}
      </p>
      <GoldDivider width={150} />
      <p class="t-display farewell__sign"><GoldText shimmer={true}>{content.farewell.signature}</GoldText></p>

      <button class="btn btn--secondary btn--on-dark farewell__restart" type="button" data-restart>
        <Icon name="restart" size={18} color="var(--clr-eggshell)" /> Begin again
      </button>
    </div>

    <div class="farewell__lantern-wrap" data-lantern-wrap>
      <div class="farewell__lantern" data-lantern>
        <Lantern width={150} />
      </div>
      <button class="btn btn--primary farewell__release" type="button" data-release>
        Release the lantern
      </button>
      <p class="farewell__hint t-label" data-hint>A small wish, sent to the sky</p>
    </div>
  </div>
</SceneShell>

<script>
  import { registerScene } from '@lib/scene-controller';
  import { gsap, DUR, EASE, dur } from '@lib/motion';
  import { prefersReducedMotion } from '@lib/reduced-motion';
  import { audio } from '@lib/audio';
  import { haptic } from '@lib/haptics';
  import { controller } from '@lib/scene-controller';

  registerScene('farewell', (root) => {
    const releaseBtn = root.querySelector<HTMLButtonElement>('[data-release]')!;
    const lantern = root.querySelector<HTMLElement>('[data-lantern]')!;
    const wrap = root.querySelector<HTMLElement>('[data-lantern-wrap]')!;
    const message = root.querySelector<HTMLElement>('[data-message]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    const flame = root.querySelector<SVGElement>('#lantern-flame')!;
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]')!;
    let flicker: gsap.core.Tween | null = null;
    let released = false;

    function release() {
      if (released) return;
      released = true;
      audio.play('lantern');
      haptic('strong');
      releaseBtn.disabled = true;

      gsap.to([releaseBtn, hint], { autoAlpha: 0, duration: dur(DUR.tap) });

      if (prefersReducedMotion()) {
        gsap.to(lantern, { autoAlpha: 0, duration: 0.3, onComplete: revealMessage });
        brightenStars();
        return;
      }

      // 2500ms gentle drift upward with a little sway
      gsap.to(lantern, {
        y: -window.innerHeight * 0.9,
        duration: 2.5,
        ease: 'power1.in',
      });
      gsap.to(lantern, { x: 18, duration: 1.6, yoyo: true, repeat: 1, ease: EASE.inOut });
      gsap.to(lantern, { scale: 0.5, autoAlpha: 0.2, duration: 2.5, ease: 'power1.in' });
      brightenStars();
      gsap.delayedCall(1.6, revealMessage);
      // fade the music to midnight
      audio.fadeAll(2500);
    }

    function brightenStars() {
      gsap.to('.farewell__star', { opacity: 1, duration: dur(DUR.camera), stagger: 0.02, ease: EASE.out });
    }

    function revealMessage() {
      message.hidden = false;
      gsap.fromTo(message, { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: dur(DUR.paper), ease: EASE.paper });
    }

    const onRelease = () => release();
    const onRestart = () => { void controller.goTo(0); };

    return {
      init() {
        releaseBtn.addEventListener('click', onRelease);
        restartBtn.addEventListener('click', onRestart);
      },
      enter() {
        released = false;
        releaseBtn.disabled = false;
        message.hidden = true;
        gsap.set(lantern, { x: 0, y: 0, scale: 1, autoAlpha: 1 });
        gsap.set('.farewell__star', { opacity: 0.4 });
        gsap.fromTo(wrap, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: dur(DUR.paper), ease: EASE.paper });
      },
      idle() {
        if (prefersReducedMotion()) return;
        flicker = gsap.to(flame, { scaleY: 0.86, scaleX: 1.06, transformOrigin: '50% 100%', duration: 0.5, yoyo: true, repeat: -1, ease: EASE.inOut });
        gsap.to(lantern, { y: -6, duration: 2.4, yoyo: true, repeat: -1, ease: EASE.inOut });
      },
      exit() {
        flicker?.kill();
        gsap.killTweensOf(lantern);
      },
      destroy() {
        flicker?.kill();
        releaseBtn.removeEventListener('click', onRelease);
        restartBtn.removeEventListener('click', onRestart);
      },
    };
  });
</script>

<style>
  .farewell {
    /* Full-bleed against the scene (full-screen containing block). */
    position: fixed;
    inset: 0;
    z-index: var(--z-content);
    display: grid;
    place-items: center;
  }
  .farewell__sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .farewell__star {
    position: absolute;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #f3ead0;
    opacity: 0.4;
    box-shadow: 0 0 4px rgba(243, 234, 208, 0.8);
    animation: twinkle 3.6s var(--d, 0s) ease-in-out infinite;
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 0.9; }
  }
  @media (prefers-reduced-motion: reduce) {
    .farewell__star { animation: none; }
  }

  .farewell__lantern-wrap {
    position: absolute;
    bottom: calc(var(--safe-bottom) + var(--sp-4));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }
  .farewell__lantern {
    width: 150px;
    will-change: transform;
  }
  .farewell__release { min-width: 220px; }
  .farewell__hint {
    font-size: var(--fs-12);
    color: var(--clr-eggshell);
    opacity: 0.8;
  }

  .farewell__message {
    text-align: center;
    max-width: 30ch;
    padding-inline: var(--pad-x);
  }
  .farewell__kicker { color: var(--clr-gold); opacity: 0.9; }
  .farewell__text {
    font-size: var(--fs-24);
    color: var(--clr-ivory);
    line-height: 1.5;
    margin-block: var(--sp-2);
  }
  .farewell__sign {
    font-size: var(--fs-48);
    margin-top: var(--sp-1);
  }
  .farewell__restart {
    margin-top: var(--sp-5);
  }
</style>
